# Database Connection String (e.g., from Neon.tech or Supabase)
DATABASE_URL=your_postgresql_database_url_here

# Create tables on startup. Defaults to on for local SQLite, OFF for Postgres
# so cold starts do not pay a schema-reflection round trip per table.
# Set to 1 for one boot against a fresh database, or after changing models.py.
RUN_MIGRATIONS=0

# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app  (defaults to "*")
ALLOWED_ORIGINS=*

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (For Order Notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SENDER_EMAIL=your_email@gmail.com

# WhatsApp Cloud API Configuration
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=order_confirmation_template_name

